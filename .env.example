# Stage 8 — Infrastructure: environment variables
#
# Copy this file to `.env` (gitignored) and fill in real values. Every variable here is read
# by backend/src/main/resources/application.yml and/or docker-compose.yml. Nothing in this
# file is a real secret — placeholders only.

# --- Database (Postgres 18) --------------------------------------------------------------
# JDBC URL the Spring Boot app connects with. Use "postgres" as the host when running under
# docker-compose, or "localhost" when running the API directly against `docker compose up postgres`.
SYNCBOARD_DB_URL=jdbc:postgresql://localhost:5432/syncboard
SYNCBOARD_DB_USER=syncboard
SYNCBOARD_DB_PASSWORD=changeme
# Database name used by the postgres container itself on first init; keep in sync with SYNCBOARD_DB_URL.
SYNCBOARD_DB_NAME=syncboard

# --- Cache / realtime backing store (Valkey 8, Redis-protocol compatible) -----------------
SYNCBOARD_REDIS_HOST=localhost
SYNCBOARD_REDIS_PORT=6379

# --- Google Workspace OIDC SSO (Stage 5) --------------------------------------------------
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console; never commit real values.
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
# Hosted-domain ("hd") claim every signed-in user's Google ID token must carry.
SYNCBOARD_ALLOWED_HD=example.com

# --- CORS ----------------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API; the Angular dev server by default.
SYNCBOARD_CORS_ORIGINS=http://localhost:4200

# --- Server --------------------------------------------------------------------------------
SERVER_PORT=8080
# One of: local (in-memory cache, GraphiQL on, debug logging, stub current-user) or default/prod.
SPRING_PROFILES_ACTIVE=local

# --- Optional overrides (sensible defaults already set in application.yml) ----------------
# SYNCBOARD_CACHE_TYPE=redis
# SYNCBOARD_GRAPHIQL_ENABLED=false
# SYNCBOARD_LOG_LEVEL=INFO
